              "timeframe": "week"
            }
          }
        ]
      },
      "metadata": {
        "skill": "web_research",
        "difficulty": "medium",
        "what_it_tests": "Tách chủ đề tìm kiếm khỏi bộ lọc news và chọn đúng timeframe theo yêu cầu."
      }
    },
    {
      "id": "G03_social_search_latest",
      "phase": "B",
      "suite": "group",
