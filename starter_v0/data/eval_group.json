{
  "dataset_id": "day03_v2_research_group",
  "dataset_role": "group",
  "description": "Custom evaluation dataset for Part 04. Includes 5 single-turn and 5 multi-turn cases, including coverage for the new compare_sources tool.",
  "cases": [
    {
      "id": "G01_compare_sources_urls",
      "phase": "B",
      "suite": "group",
      "query": "So sánh nguồn của các URL này và cho biết chúng đến từ bao nhiêu website khác nhau: https://openai.com/research và https://www.openai.com/blog, https://arxiv.org/abs/2301.00001",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "compare_sources",
            "args": {
              "urls": [
                "https://openai.com/research",
                "https://www.openai.com/blog",
                "https://arxiv.org/abs/2301.00001"
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "source_comparison",
        "difficulty": "easy",
        "what_it_tests": "Chọn compare_sources khi người dùng cung cấp danh sách URL và muốn nhóm, đếm nguồn theo tên miền."
      }
    },
    {
      "id": "G02_lookup_ai_news",
      "phase": "B",
      "suite": "group",
      "query": "Tra cứu các nghiên cứu mới về ứng dụng AI trong quản lý năng lượng tòa nhà trong tuần này.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "AI trong quản lý năng lượng tòa nhà",
