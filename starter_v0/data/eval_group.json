              "limit": 5
            }
          }
        ]
      },
      "metadata": {
        "skill": "social_research",
        "difficulty": "medium",
        "what_it_tests": "Chọn social_search thay vì lookup và truyền đúng loại sắp xếp cùng giới hạn kết quả."
      }
